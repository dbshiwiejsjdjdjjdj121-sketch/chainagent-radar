# Etherscan API V2 key for BNB Smart Chain indexer enrichment.
# Create a key from Etherscan/BscScan, then copy this file to `.env.local`.
# Browser-exposed Vite keys are public in client demos; use a server proxy for production.
VITE_ETHERSCAN_API_KEY=

# QIE Hackathon local deployment script.
# Use a dedicated test wallet only. Never paste a main-wallet private key.
QIE_PRIVATE_KEY=
QIE_SUBJECT_ADDRESS=
QIE_RPC_URL=https://rpc1testnet.qie.digital/
QIE_EXPLORER_URL=https://testnet.qie.digital
QIE_PROJECT_NAME=QIE Growth Copilot
QIE_READINESS_SCORE=88
QIE_ECOSYSTEM_ACTION=AI wallet growth brief anchored for QIE Hackathon 2026

# 0G APAC local upload script.
# Never expose this private key in a browser build, screenshot, README, or chat.
# Copy `.env.example` to `.env.local`, then fill only on your own machine.
ZERO_G_PRIVATE_KEY=
ZERO_G_WALLET_ADDRESS=
ZERO_G_RPC_URL=https://evmrpc-testnet.0g.ai
ZERO_G_INDEXER_RPC=https://indexer-storage-testnet-turbo.0g.ai
ZERO_G_CHAIN_SCAN_BASE=https://chainscan-galileo.0g.ai
ZERO_G_STORAGE_SCAN_BASE=https://storagescan-galileo.0g.ai
