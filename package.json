{
  "name": "chainagent-radar",
  "private": true,
  "version": "0.1.0",
  "description": "AI wallet intelligence for Web3 hackathon submissions.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "npm run check && vite build",
    "check": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "preview": "vite preview --host 0.0.0.0",
    "qie:dry-run": "node scripts/deploy-qie-growth-proof.mjs --dry-run",
    "qie:deploy": "node scripts/deploy-qie-growth-proof.mjs",
    "zerog:dry-run": "node scripts/upload-zerog-memory.mjs --dry-run",
    "zerog:upload": "node scripts/upload-zerog-memory.mjs"
  },
  "dependencies": {
    "@0gfoundation/0g-storage-ts-sdk": "^1.2.9",
    "@vitejs/plugin-react": "^4.4.1",
    "dotenv": "^17.4.2",
    "ethers": "^6.13.1",
    "lucide-react": "^0.507.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "vite": "^6.3.4"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "playwright": "^1.59.1",
    "solc": "^0.8.35",
    "typescript": "^5.8.3"
  }
}
